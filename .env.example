# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Transaction-mode PostgreSQL — use port 6543 (pgbouncer), NOT 5432.
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify
# Must point to the SAME Supabase project as NEXT_PUBLIC_SUPABASE_URL below.
# Payload tables use the default 'public' schema. ERP tables are accessed via
# the Supabase JS client (REST API), so there is no table-name conflict.
# NOTE: Free-tier Supabase projects auto-pause after 1 week of inactivity —
#       visit the Supabase dashboard and click "Restore project" if login fails.
DATABASE_URI=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify

# ── Supabase (shared project — same credentials as siva-sai-erp) ──────────────
# Used to read ERP products (public.products) for the storefront.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service-role key — only used by app/api/revalidate-catalog to write the
# replay-protection nonce table (RLS blocks anon/authenticated from it).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Catalog cache invalidation (shared with siva-sai-erp) ─────────────────────
# Must match PRODUCT_REVALIDATION_SECRET in the ERP's env exactly — it signs
# the "a product changed" webhook that POSTs to /api/revalidate-catalog.
PRODUCT_REVALIDATION_SECRET=generate_a_long_random_secret

# ── Payload CMS ───────────────────────────────────────────────────────────────
PAYLOAD_SECRET=change-this-to-a-long-random-string

# ── App URL ───────────────────────────────────────────────────────────────────
# Set to your production domain on Vercel (e.g. https://siva-sai-products.vercel.app).
# On Vercel, VERCEL_URL is auto-set, so this only needs to be set for custom domains.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AWS S3 + CloudFront (shared with siva-sai-erp) ────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your-bucket-name
NEXT_PUBLIC_CLOUDFRONT_URL=https://YOUR_DISTRIBUTION_ID.cloudfront.net

# ── Business contact info (public) ────────────────────────────────────────────
NEXT_PUBLIC_PHONE=+91-XXXXX-XXXXX
NEXT_PUBLIC_EMAIL=info@sivasaiproducts.com
NEXT_PUBLIC_ADDRESS=Hosur, Tamil Nadu - 635109
NEXT_PUBLIC_WHATSAPP_NUMBER=919XXXXXXXXX
